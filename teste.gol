programa
{
	/*
		=========================================================
		MEGA LABORATÓRIO DE PORTUGOL
		Autor: Marafon
		Objetivo:
		Mostrar vários recursos possíveis do Portugol em um código só.

		Conteúdo:
		1 - Tipos de variáveis
		2 - Entrada e saída
		3 - Operadores matemáticos
		4 - Operadores relacionais
		5 - Operadores lógicos
		6 - Se / senao
		7 - Escolha / caso
		8 - Laço para
		9 - Laço enquanto
		10 - Laço faca enquanto
		11 - Vetores
		12 - Matrizes
		13 - Funções com retorno
		14 - Procedimentos sem retorno
		15 - Recursão
		16 - Calculadora
		17 - Média de notas
		18 - Tabuada
		19 - Par ou ímpar
		20 - Maior e menor número
		21 - Simulação de login
		22 - Jogo de adivinhação simples
		23 - Validação de dados
		24 - Comentários e boas práticas
		=========================================================
	*/

	const inteiro TAMANHO_VETOR = 5
	const inteiro LINHAS = 3
	const inteiro COLUNAS = 3

	funcao inicio()
	{
		inteiro opcao

		faca
		{
			limparTelaFake()

			escreva("\n====================================")
			escreva("\n       MEGA MENU DE PORTUGOL")
			escreva("\n====================================")
			escreva("\n1  - Tipos de variáveis")
			escreva("\n2  - Entrada e saída")
			escreva("\n3  - Operadores matemáticos")
			escreva("\n4  - Operadores relacionais")
			escreva("\n5  - Operadores lógicos")
			escreva("\n6  - Condicional SE / SENAO")
			escreva("\n7  - Escolha / Caso")
			escreva("\n8  - Laço PARA")
			escreva("\n9  - Laço ENQUANTO")
			escreva("\n10 - Laço FACA ENQUANTO")
			escreva("\n11 - Vetores")
			escreva("\n12 - Matrizes")
			escreva("\n13 - Funções com retorno")
			escreva("\n14 - Procedimentos sem retorno")
			escreva("\n15 - Recursão")
			escreva("\n16 - Calculadora")
			escreva("\n17 - Média de notas")
			escreva("\n18 - Tabuada")
			escreva("\n19 - Par ou ímpar")
			escreva("\n20 - Maior e menor número")
			escreva("\n21 - Simulação de login")
			escreva("\n22 - Jogo de adivinhação")
			escreva("\n23 - Validação de idade")
			escreva("\n24 - Exemplo completo com aluno")
			escreva("\n0  - Sair")
			escreva("\n====================================")
			escreva("\nEscolha uma opção: ")
			leia(opcao)

			escolha(opcao)
			{
				caso 1:
					exemploTipos()
					pare

				caso 2:
					exemploEntradaSaida()
					pare

				caso 3:
					exemploOperadoresMatematicos()
					pare

				caso 4:
					exemploOperadoresRelacionais()
					pare

				caso 5:
					exemploOperadoresLogicos()
					pare

				caso 6:
					exemploSeSenao()
					pare

				caso 7:
					exemploEscolhaCaso()
					pare

				caso 8:
					exemploLacoPara()
					pare

				caso 9:
					exemploLacoEnquanto()
					pare

				caso 10:
					exemploFacaEnquanto()
					pare

				caso 11:
					exemploVetores()
					pare

				caso 12:
					exemploMatrizes()
					pare

				caso 13:
					exemploFuncoesComRetorno()
					pare

				caso 14:
					exemploProcedimentos()
					pare

				caso 15:
					exemploRecursao()
					pare

				caso 16:
					calculadora()
					pare

				caso 17:
					mediaNotas()
					pare

				caso 18:
					tabuada()
					pare

				caso 19:
					parOuImpar()
					pare

				caso 20:
					maiorMenor()
					pare

				caso 21:
					simulacaoLogin()
					pare

				caso 22:
					jogoAdivinhacao()
					pare

				caso 23:
					validarIdade()
					pare

				caso 24:
					exemploAlunoCompleto()
					pare

				caso 0:
					escreva("\nSaindo do programa...")
					pare

				caso contrario:
					escreva("\nOpção inválida.")
					pare
			}

			se(opcao != 0)
			{
				pausar()
			}

		} enquanto(opcao != 0)

		escreva("\nPrograma finalizado. Bons estudos, Marafon!")
	}

	funcao limparTelaFake()
	{
		escreva("\n\n\n")
	}

	funcao pausar()
	{
		cadeia enter

		escreva("\n\nDigite qualquer coisa e pressione ENTER para voltar ao menu: ")
		leia(enter)
	}

	funcao exemploTipos()
	{
		inteiro idade
		real altura
		cadeia nome
		caracter letra
		logico aprovado

		idade = 17
		altura = 1.77
		nome = "Mateus"
		letra = 'M'
		aprovado = verdadeiro

		escreva("\n===== TIPOS DE VARIÁVEIS =====")

		escreva("\nInteiro: ", idade)
		escreva("\nReal: ", altura)
		escreva("\nCadeia: ", nome)
		escreva("\nCaracter: ", letra)
		escreva("\nLogico: ", aprovado)

		escreva("\n\nTipos principais:")
		escreva("\ninteiro  -> números sem vírgula")
		escreva("\nreal     -> números com vírgula")
		escreva("\ncadeia   -> textos")
		escreva("\ncaracter -> uma letra")
		escreva("\nlogico   -> verdadeiro ou falso")
	}

	funcao exemploEntradaSaida()
	{
		cadeia nome
		inteiro idade
		real nota

		escreva("\n===== ENTRADA E SAÍDA =====")

		escreva("\nDigite seu nome: ")
		leia(nome)

		escreva("Digite sua idade: ")
		leia(idade)

		escreva("Digite sua nota: ")
		leia(nota)

		escreva("\nNome informado: ", nome)
		escreva("\nIdade informada: ", idade)
		escreva("\nNota informada: ", nota)
	}

	funcao exemploOperadoresMatematicos()
	{
		inteiro a, b
		inteiro soma, subtracao, multiplicacao, divisaoInteira, resto
		real divisaoReal

		a = 10
		b = 3

		soma = a + b
		subtracao = a - b
		multiplicacao = a * b
		divisaoInteira = a / b
		resto = a % b
		divisaoReal = 10.0 / 3.0

		escreva("\n===== OPERADORES MATEMÁTICOS =====")

		escreva("\nA = ", a)
		escreva("\nB = ", b)

		escreva("\n\nSoma: ", soma)
		escreva("\nSubtração: ", subtracao)
		escreva("\nMultiplicação: ", multiplicacao)
		escreva("\nDivisão inteira: ", divisaoInteira)
		escreva("\nDivisão real: ", divisaoReal)
		escreva("\nResto da divisão: ", resto)

		escreva("\n\nOperadores:")
		escreva("\n+  soma")
		escreva("\n-  subtração")
		escreva("\n*  multiplicação")
		escreva("\n/  divisão")
		escreva("\n%  resto da divisão")
	}

	funcao exemploOperadoresRelacionais()
	{
		inteiro a, b

		a = 10
		b = 5

		escreva("\n===== OPERADORES RELACIONAIS =====")

		escreva("\nA = ", a)
		escreva("\nB = ", b)

		escreva("\n\nA == B: ", a == b)
		escreva("\nA != B: ", a != b)
		escreva("\nA > B: ", a > b)
		escreva("\nA < B: ", a < b)
		escreva("\nA >= B: ", a >= b)
		escreva("\nA <= B: ", a <= b)

		escreva("\n\nOperadores:")
		escreva("\n== igual")
		escreva("\n!= diferente")
		escreva("\n>  maior")
		escreva("\n<  menor")
		escreva("\n>= maior ou igual")
		escreva("\n<= menor ou igual")
	}

	funcao exemploOperadoresLogicos()
	{
		logico temIdade
		logico temAutorizacao
		logico podeEntrar

		temIdade = falso
		temAutorizacao = verdadeiro

		podeEntrar = temIdade ou temAutorizacao

		escreva("\n===== OPERADORES LÓGICOS =====")

		escreva("\nTem idade? ", temIdade)
		escreva("\nTem autorização? ", temAutorizacao)

		escreva("\n\nPode entrar usando OU? ", podeEntrar)
		escreva("\nTem idade E autorização? ", temIdade e temAutorizacao)
		escreva("\nNÃO tem idade? ", nao temIdade)

		escreva("\n\nOperadores:")
		escreva("\ne   -> as duas condições precisam ser verdadeiras")
		escreva("\nou  -> pelo menos uma condição precisa ser verdadeira")
		escreva("\nnao -> inverte verdadeiro/falso")
	}

	funcao exemploSeSenao()
	{
		real nota

		escreva("\n===== SE / SENAO =====")

		escreva("\nDigite uma nota: ")
		leia(nota)

		se(nota >= 7)
		{
			escreva("\nAprovado.")
		}
		senao se(nota >= 5)
		{
			escreva("\nRecuperação.")
		}
		senao
		{
			escreva("\nReprovado.")
		}
	}

	funcao exemploEscolhaCaso()
	{
		inteiro dia

		escreva("\n===== ESCOLHA / CASO =====")

		escreva("\nDigite um número de 1 a 7: ")
		leia(dia)

		escolha(dia)
		{
			caso 1:
				escreva("\nDomingo")
				pare

			caso 2:
				escreva("\nSegunda-feira")
				pare

			caso 3:
				escreva("\nTerça-feira")
				pare

			caso 4:
				escreva("\nQuarta-feira")
				pare

			caso 5:
				escreva("\nQuinta-feira")
				pare

			caso 6:
				escreva("\nSexta-feira")
				pare

			caso 7:
				escreva("\nSábado")
				pare

			caso contrario:
				escreva("\nDia inválido.")
				pare
		}
	}

	funcao exemploLacoPara()
	{
		inteiro i

		escreva("\n===== LAÇO PARA =====")

		escreva("\nContando de 1 até 10:")

		para(i = 1; i <= 10; i++)
		{
			escreva("\nNúmero: ", i)
		}

		escreva("\n\nContando de 10 até 1:")

		para(i = 10; i >= 1; i--)
		{
			escreva("\nNúmero: ", i)
		}
	}

	funcao exemploLacoEnquanto()
	{
		inteiro contador

		contador = 1

		escreva("\n===== LAÇO ENQUANTO =====")

		enquanto(contador <= 5)
		{
			escreva("\nContador: ", contador)
			contador++
		}
	}

	funcao exemploFacaEnquanto()
	{
		inteiro numero

		escreva("\n===== LAÇO FACA ENQUANTO =====")

		faca
		{
			escreva("\nDigite um número positivo: ")
			leia(numero)

			se(numero < 0)
			{
				escreva("\nNúmero inválido. Tente novamente.")
			}

		} enquanto(numero < 0)

		escreva("\nVocê digitou: ", numero)
	}

	funcao exemploVetores()
	{
		inteiro numeros[TAMANHO_VETOR]
		inteiro i
		inteiro soma
		real media

		soma = 0

		escreva("\n===== VETORES =====")

		para(i = 0; i < TAMANHO_VETOR; i++)
		{
			escreva("\nDigite o número da posição ", i, ": ")
			leia(numeros[i])
		}

		escreva("\n\nValores digitados:")

		para(i = 0; i < TAMANHO_VETOR; i++)
		{
			escreva("\nPosição ", i, ": ", numeros[i])
			soma = soma + numeros[i]
		}

		media = soma / 1.0 / TAMANHO_VETOR

		escreva("\n\nSoma: ", soma)
		escreva("\nMédia: ", media)
	}

	funcao exemploMatrizes()
	{
		inteiro matriz[LINHAS][COLUNAS]
		inteiro linha, coluna
		inteiro soma

		soma = 0

		escreva("\n===== MATRIZES =====")

		para(linha = 0; linha < LINHAS; linha++)
		{
			para(coluna = 0; coluna < COLUNAS; coluna++)
			{
				escreva("\nDigite o valor da posição [", linha, "][", coluna, "]: ")
				leia(matriz[linha][coluna])
			}
		}

		escreva("\n\nMatriz digitada:\n")

		para(linha = 0; linha < LINHAS; linha++)
		{
			para(coluna = 0; coluna < COLUNAS; coluna++)
			{
				escreva(matriz[linha][coluna], " ")
				soma = soma + matriz[linha][coluna]
			}

			escreva("\n")
		}

		escreva("\nSoma de todos os valores: ", soma)
	}

	funcao exemploFuncoesComRetorno()
	{
		inteiro a, b
		inteiro resultadoSoma
		inteiro resultadoMaior
		real resultadoMedia

		escreva("\n===== FUNÇÕES COM RETORNO =====")

		escreva("\nDigite o primeiro número: ")
		leia(a)

		escreva("Digite o segundo número: ")
		leia(b)

		resultadoSoma = somar(a, b)
		resultadoMaior = maiorEntreDois(a, b)
		resultadoMedia = calcularMediaDoisNumeros(a, b)

		escreva("\nSoma: ", resultadoSoma)
		escreva("\nMaior número: ", resultadoMaior)
		escreva("\nMédia: ", resultadoMedia)
	}

	funcao exemploProcedimentos()
	{
		cadeia nome

		escreva("\n===== PROCEDIMENTOS SEM RETORNO =====")

		escreva("\nDigite seu nome: ")
		leia(nome)

		mostrarLinha()
		mostrarMensagemBoasVindas(nome)
		mostrarLinha()
	}

	funcao exemploRecursao()
	{
		inteiro numero
		inteiro resultado

		escreva("\n===== RECURSÃO =====")

		escreva("\nDigite um número para calcular o fatorial: ")
		leia(numero)

		se(numero < 0)
		{
			escreva("\nNão existe fatorial de número negativo.")
		}
		senao
		{
			resultado = fatorial(numero)
			escreva("\nFatorial de ", numero, " = ", resultado)
		}
	}

	funcao calculadora()
	{
		real a, b, resultado
		inteiro opcao

		escreva("\n===== CALCULADORA =====")

		escreva("\nDigite o primeiro número: ")
		leia(a)

		escreva("Digite o segundo número: ")
		leia(b)

		escreva("\n1 - Soma")
		escreva("\n2 - Subtração")
		escreva("\n3 - Multiplicação")
		escreva("\n4 - Divisão")
		escreva("\nEscolha: ")
		leia(opcao)

		escolha(opcao)
		{
			caso 1:
				resultado = a + b
				escreva("\nResultado: ", resultado)
				pare

			caso 2:
				resultado = a - b
				escreva("\nResultado: ", resultado)
				pare

			caso 3:
				resultado = a * b
				escreva("\nResultado: ", resultado)
				pare

			caso 4:
				se(b == 0)
				{
					escreva("\nErro: não é possível dividir por zero.")
				}
				senao
				{
					resultado = a / b
					escreva("\nResultado: ", resultado)
				}
				pare

			caso contrario:
				escreva("\nOperação inválida.")
				pare
		}
	}

	funcao mediaNotas()
	{
		real n1, n2, n3, media

		escreva("\n===== MÉDIA DE NOTAS =====")

		escreva("\nDigite a primeira nota: ")
		leia(n1)

		escreva("Digite a segunda nota: ")
		leia(n2)

		escreva("Digite a terceira nota: ")
		leia(n3)

		media = (n1 + n2 + n3) / 3

		escreva("\nMédia: ", media)

		se(media >= 7)
		{
			escreva("\nSituação: aprovado")
		}
		senao se(media >= 5)
		{
			escreva("\nSituação: recuperação")
		}
		senao
		{
			escreva("\nSituação: reprovado")
		}
	}

	funcao tabuada()
	{
		inteiro numero
		inteiro i

		escreva("\n===== TABUADA =====")

		escreva("\nDigite um número: ")
		leia(numero)

		para(i = 1; i <= 10; i++)
		{
			escreva("\n", numero, " x ", i, " = ", numero * i)
		}
	}

	funcao parOuImpar()
	{
		inteiro numero

		escreva("\n===== PAR OU ÍMPAR =====")

		escreva("\nDigite um número: ")
		leia(numero)

		se(numero % 2 == 0)
		{
			escreva("\nO número ", numero, " é par.")
		}
		senao
		{
			escreva("\nO número ", numero, " é ímpar.")
		}
	}

	funcao maiorMenor()
	{
		inteiro a, b, c
		inteiro maior, menor

		escreva("\n===== MAIOR E MENOR =====")

		escreva("\nDigite o primeiro número: ")
		leia(a)

		escreva("Digite o segundo número: ")
		leia(b)

		escreva("Digite o terceiro número: ")
		leia(c)

		maior = a
		menor = a

		se(b > maior)
		{
			maior = b
		}

		se(c > maior)
		{
			maior = c
		}

		se(b < menor)
		{
			menor = b
		}

		se(c < menor)
		{
			menor = c
		}

		escreva("\nMaior: ", maior)
		escreva("\nMenor: ", menor)
	}

	funcao simulacaoLogin()
	{
		cadeia usuario
		cadeia senha

		cadeia usuarioCorreto
		cadeia senhaCorreta

		usuarioCorreto = "admin"
		senhaCorreta = "1234"

		escreva("\n===== LOGIN =====")

		escreva("\nUsuário: ")
		leia(usuario)

		escreva("Senha: ")
		leia(senha)

		se(usuario == usuarioCorreto e senha == senhaCorreta)
		{
			escreva("\nLogin realizado com sucesso.")
		}
		senao
		{
			escreva("\nUsuário ou senha incorretos.")
		}
	}

	funcao jogoAdivinhacao()
	{
		inteiro secreto
		inteiro chute
		inteiro tentativas

		secreto = 7
		tentativas = 0

		escreva("\n===== JOGO DE ADIVINHAÇÃO =====")
		escreva("\nTente adivinhar o número secreto entre 1 e 10.")

		faca
		{
			escreva("\nDigite seu chute: ")
			leia(chute)

			tentativas++

			se(chute < secreto)
			{
				escreva("\nO número secreto é maior.")
			}
			senao se(chute > secreto)
			{
				escreva("\nO número secreto é menor.")
			}
			senao
			{
				escreva("\nAcertou! O número era ", secreto)
				escreva("\nTentativas: ", tentativas)
			}

		} enquanto(chute != secreto)
	}

	funcao validarIdade()
	{
		inteiro idade

		escreva("\n===== VALIDAÇÃO DE IDADE =====")

		faca
		{
			escreva("\nDigite uma idade entre 0 e 120: ")
			leia(idade)

			se(idade < 0 ou idade > 120)
			{
				escreva("\nIdade inválida. Parece idade de vampiro bugado.")
			}

		} enquanto(idade < 0 ou idade > 120)

		escreva("\nIdade válida: ", idade)

		se(idade >= 18)
		{
			escreva("\nPessoa maior de idade.")
		}
		senao
		{
			escreva("\nPessoa menor de idade.")
		}
	}

	funcao exemploAlunoCompleto()
	{
		cadeia nome
		inteiro idade
		real nota1, nota2, nota3
		real media
		logico aprovado

		escreva("\n===== EXEMPLO COMPLETO COM ALUNO =====")

		escreva("\nDigite o nome do aluno: ")
		leia(nome)

		escreva("Digite a idade: ")
		leia(idade)

		escreva("Digite a nota 1: ")
		leia(nota1)

		escreva("Digite a nota 2: ")
		leia(nota2)

		escreva("Digite a nota 3: ")
		leia(nota3)

		media = calcularMediaTresNotas(nota1, nota2, nota3)

		aprovado = media >= 7

		escreva("\n===== BOLETIM =====")
		escreva("\nNome: ", nome)
		escreva("\nIdade: ", idade)
		escreva("\nNota 1: ", nota1)
		escreva("\nNota 2: ", nota2)
		escreva("\nNota 3: ", nota3)
		escreva("\nMédia: ", media)

		se(aprovado)
		{
			escreva("\nSituação: aprovado")
		}
		senao se(media >= 5)
		{
			escreva("\nSituação: recuperação")
		}
		senao
		{
			escreva("\nSituação: reprovado")
		}
	}

	funcao inteiro somar(inteiro a, inteiro b)
	{
		retorne a + b
	}

	funcao inteiro subtrair(inteiro a, inteiro b)
	{
		retorne a - b
	}

	funcao inteiro multiplicar(inteiro a, inteiro b)
	{
		retorne a * b
	}

	funcao real dividir(real a, real b)
	{
		se(b == 0)
		{
			retorne 0.0
		}

		retorne a / b
	}

	funcao inteiro maiorEntreDois(inteiro a, inteiro b)
	{
		se(a > b)
		{
			retorne a
		}
		senao
		{
			retorne b
		}
	}

	funcao inteiro menorEntreDois(inteiro a, inteiro b)
	{
		se(a < b)
		{
			retorne a
		}
		senao
		{
			retorne b
		}
	}

	funcao real calcularMediaDoisNumeros(real a, real b)
	{
		retorne (a + b) / 2
	}

	funcao real calcularMediaTresNotas(real n1, real n2, real n3)
	{
		retorne (n1 + n2 + n3) / 3
	}

	funcao logico ehPar(inteiro numero)
	{
		se(numero % 2 == 0)
		{
			retorne verdadeiro
		}
		senao
		{
			retorne falso
		}
	}

	funcao logico ehImpar(inteiro numero)
	{
		se(numero % 2 != 0)
		{
			retorne verdadeiro
		}
		senao
		{
			retorne falso
		}
	}

	funcao logico ehMaiorDeIdade(inteiro idade)
	{
		retorne idade >= 18
	}

	funcao inteiro fatorial(inteiro numero)
	{
		se(numero == 0 ou numero == 1)
		{
			retorne 1
		}
		senao
		{
			retorne numero * fatorial(numero - 1)
		}
	}

	funcao inteiro potencia(inteiro base, inteiro expoente)
	{
		inteiro resultado
		inteiro i

		resultado = 1

		para(i = 1; i <= expoente; i++)
		{
			resultado = resultado * base
		}

		retorne resultado
	}

	funcao inteiro somarDeUmAteN(inteiro n)
	{
		se(n <= 0)
		{
			retorne 0
		}

		retorne n + somarDeUmAteN(n - 1)
	}

	funcao mostrarLinha()
	{
		escreva("\n------------------------------------")
	}

	funcao mostrarMensagemBoasVindas(cadeia nome)
	{
		escreva("\nBem-vindo, ", nome, "!")
		escreva("\nEste é um exemplo de procedimento.")
	}

	funcao mostrarErro(cadeia mensagem)
	{
		escreva("\nERRO: ", mensagem)
	}

	funcao mostrarSucesso(cadeia mensagem)
	{
		escreva("\nSUCESSO: ", mensagem)
	}
}