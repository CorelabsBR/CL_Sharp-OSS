  "tokenColors": [
    {
      "scope": ["comment", "comment.block", "comment.line", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#9C7C8A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#FFCCE1" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#FFCB94" }
    },
    {
      "scope": ["constant.character.escape", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#9EE0D8" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.other", "keyword.control.flow"],
      "settings": {
        "foreground": "#F2568F",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#C99AAE",
        "fontStyle": "normal"
      }
    },
    {
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#FF7AB8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.other.object"],
      "settings": { "foreground": "#C99AAE" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#D0A0B4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable.language", "variable.language.this"],
      "settings": {
        "foreground": "#FF7AB8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["number", "constant.numeric"],
      "settings": { "foreground": "#E3A8DA" }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#FFB6D5" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#C9A0F5" }
    },
    {
      "scope": ["entity.name.method"],
      "settings": { "foreground": "#D4B4F8" }
    },
    {
      "scope": ["entity.name.type", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#F0A8C9" }
    },
    {
      "scope": ["entity.name.class", "support.class"],
      "settings": {
        "foreground": "#F0A8C9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["entity.name.interface"],
      "settings": {
        "foreground": "#E8B4E8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#C99AAE" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#FFB6D5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#F2568F" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace"],
      "settings": { "foreground": "#B893A0" }
    },
    {
      "scope": ["meta"],
      "settings": { "foreground": "#D0A8B8" }
    },
    {
      "scope": ["support.constant.property-value", "meta.property-value"],
      "settings": { "foreground": "#FFCCE1" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#FFF3F8",
        "background": "#A0305C"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#EACBD9",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#FFEAF2" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#FFEAF2" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "fontStyle": "bold", "foreground": "#F2568F" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#9C7C8A", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#FFCCE1" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#C9A0F5" }
    }
  ],

  "semanticTokenColors": {
    "class": { "foreground": "#F0A8C9", "bold": true },
    "class.defaultLibrary": { "foreground": "#F0A8C9" },
    "interface": { "foreground": "#E8B4E8", "italic": true },
    "enum": { "foreground": "#F0A8C9" },
    "enumMember": { "foreground": "#FFB6D5" },
    "namespace": { "foreground": "#C99AAE" },
    "struct": { "foreground": "#F0A8C9" },
    "typeParameter": { "foreground": "#EABAD0", "italic": true },
    "type": { "foreground": "#F0A8C9" },
    "type.defaultLibrary": { "foreground": "#EE9BC0" },

    "decorator": { "foreground": "#FFB6D5", "italic": true },
    "macro": { "foreground": "#FF7AB8", "bold": true },
    "label": { "foreground": "#C99AAE", "italic": true },

    "parameter": { "foreground": "#D0A0B4", "italic": true },
    "property": { "foreground": "#C99AAE" },
    "property.readonly": { "foreground": "#FFB6D5" },
    "property.static": { "foreground": "#D9AEC0", "bold": true },

    "variable": { "foreground": "#C99AAE" },
    "variable.readonly": { "foreground": "#FFB6D5" },
    "variable.local": { "foreground": "#C99AAE" },
    "variable.global": { "foreground": "#D9AEC0" },
    "variable.defaultLibrary": { "foreground": "#D9AEC0" },

    "function": { "foreground": "#C9A0F5" },
    "function.defaultLibrary": { "foreground": "#D4B4F8" },
    "method": { "foreground": "#D4B4F8" },
    "function.async": { "foreground": "#C9A0F5", "italic": true },
    "method.async": { "foreground": "#D4B4F8", "italic": true },
    "constructor": { "foreground": "#FF7AB8", "bold": true },

    "regexp": { "foreground": "#FFCB94" },
    "escapeSequence": { "foreground": "#9EE0D8" },

    "comment": { "foreground": "#9C7C8A", "italic": true },
    "string": { "foreground": "#FFCCE1" },
    "number": { "foreground": "#E3A8DA" },
    "keyword": { "foreground": "#F2568F", "bold": true },
    "operator": { "foreground": "#C99AAE" }
  }
}