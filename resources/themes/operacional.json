  "tokenColors": [
    {
      "scope": ["comment", "comment.block", "comment.line", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#75806C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#A9C47A" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#D0A64A" }
    },
    {
      "scope": ["constant.character.escape", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#86AAA0" }
    },
    {
      "scope": ["keyword", "keyword.control", "keyword.other", "keyword.control.flow"],
      "settings": {
        "foreground": "#D6B86C",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#B8BEAA",
        "fontStyle": "normal"
      }
    },
    {
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#C9B06A",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.other.object"],
      "settings": { "foreground": "#D6DCCB" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#C7BA8A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable.language", "variable.language.this"],
      "settings": {
        "foreground": "#D6B86C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["number", "constant.numeric"],
      "settings": { "foreground": "#D0A64A" }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": { "foreground": "#D8C58D" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#9EBB70" }
    },
    {
      "scope": ["entity.name.method"],
      "settings": { "foreground": "#ABC67A" }
    },
    {
      "scope": ["entity.name.type", "support.type", "entity.other.inherited-class"],
      "settings": { "foreground": "#B9C88E" }
    },
    {
      "scope": ["entity.name.class", "support.class"],
      "settings": {
        "foreground": "#C2B280",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["entity.name.interface"],
      "settings": {
        "foreground": "#A5B879",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.namespace", "entity.name.module"],
      "settings": { "foreground": "#AEB8A0" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#9EBB70",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#C6A15B" }
    },
    {
      "scope": ["punctuation", "punctuation.separator", "punctuation.terminator", "meta.brace"],
      "settings": { "foreground": "#8F9986" }
    },
    {
      "scope": ["meta"],
      "settings": { "foreground": "#AEB8A0" }
    },
    {
      "scope": ["support.constant.property-value", "meta.property-value"],
      "settings": { "foreground": "#A9C47A" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#F0F2E8",
        "background": "#7A3025"
      }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#E4E8DA",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#F0F2E8" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#F0F2E8" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "fontStyle": "bold", "foreground": "#C6A15B" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#7F8975", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.raw"],
      "settings": { "foreground": "#A9C47A" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#86AAA0" }
    }
  ],

  "semanticTokenColors": {
    "class": { "foreground": "#C2B280", "bold": true },
    "class.defaultLibrary": { "foreground": "#C2B280" },
    "interface": { "foreground": "#A5B879", "italic": true },
    "enum": { "foreground": "#C2B280" },
    "enumMember": { "foreground": "#D8C58D" },
    "namespace": { "foreground": "#AEB8A0" },
    "struct": { "foreground": "#C2B280" },
    "typeParameter": { "foreground": "#B9C88E", "italic": true },
    "type": { "foreground": "#B9C88E" },
    "type.defaultLibrary": { "foreground": "#B9C88E" },

    "decorator": { "foreground": "#D8C58D", "italic": true },
    "macro": { "foreground": "#D6B86C", "bold": true },
    "label": { "foreground": "#AEB8A0", "italic": true },

    "parameter": { "foreground": "#C7BA8A", "italic": true },
    "property": { "foreground": "#AEB8A0" },
    "property.readonly": { "foreground": "#D8C58D" },
    "property.static": { "foreground": "#C7BA8A", "bold": true },

    "variable": { "foreground": "#D6DCCB" },
    "variable.readonly": { "foreground": "#D8C58D" },
    "variable.local": { "foreground": "#D6DCCB" },
    "variable.global": { "foreground": "#C7BA8A" },
    "variable.defaultLibrary": { "foreground": "#C7BA8A" },

    "function": { "foreground": "#9EBB70" },
    "function.defaultLibrary": { "foreground": "#ABC67A" },
    "method": { "foreground": "#ABC67A" },
    "function.async": { "foreground": "#9EBB70", "italic": true },
    "method.async": { "foreground": "#ABC67A", "italic": true },
    "constructor": { "foreground": "#D6B86C", "bold": true },

    "regexp": { "foreground": "#D0A64A" },
    "escapeSequence": { "foreground": "#86AAA0" },

    "comment": { "foreground": "#75806C", "italic": true },
    "string": { "foreground": "#A9C47A" },
    "number": { "foreground": "#D0A64A" },
    "keyword": { "foreground": "#D6B86C", "bold": true },
    "operator": { "foreground": "#B8BEAA" }
  }
}