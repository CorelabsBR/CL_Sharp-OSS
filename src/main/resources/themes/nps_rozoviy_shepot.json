{
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "name": "Sussurro Rosa — Girly",

  "colors": {
    "foreground": "#FFEAF5",
    "editor.background": "#2A1024",
    "editor.foreground": "#FFEAF5",

    "editorCursor.foreground": "#FF4FA3",
    "editor.lineHighlightBackground": "#3C1631",
    "editor.selectionBackground": "#5C2049",
    "editorWhitespace.foreground": "#FFB3D966",

    "editorLineNumber.foreground": "#B57CA0",
    "editorLineNumber.activeForeground": "#FFB3D9",
    "editorBracketMatch.border": "#FF9EE8",

    "activityBar.background": "#2A1024",
    "activityBar.foreground": "#FF6FBF",
    "activityBarBadge.background": "#FF9EE8",
    "activityBarBadge.foreground": "#3C0A2E",

    "sideBar.background": "#230D1F",
    "sideBar.foreground": "#FFDCEF",

    "tab.activeBackground": "#2A1024",
    "tab.inactiveBackground": "#230D1F",
    "tab.activeForeground": "#FF9EE8",
    "tab.inactiveForeground": "#C48EB0",

    "statusBar.background": "#3C1631",
    "statusBar.foreground": "#FF9EE8",
    "statusBar.debuggingBackground": "#FF6FBF",
    "statusBar.debuggingForeground": "#3C0A2E",

    "titleBar.activeBackground": "#2A1024",
    "titleBar.activeForeground": "#FF9EE8",

    "terminal.background": "#2A1024",
    "terminal.foreground": "#FFEAF5",
    "terminalCursor.foreground": "#FF4FA3",

    "terminal.ansiRed": "#FF6FA8",
    "terminal.ansiGreen": "#B6FFCE",
    "terminal.ansiYellow": "#FFE0EE",
    "terminal.ansiBlue": "#C9AFFF",
    "terminal.ansiMagenta": "#FF9EE8",
    "terminal.ansiCyan": "#9EFFF0",
    "terminal.ansiWhite": "#FFFFFF",

    "errorForeground": "#FF4F8F"
  },

  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#D48FB0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "string",
      "settings": { "foreground": "#FFD1E8" }
    },
    {
      "scope": "keyword",
      "settings": {
        "foreground": "#FF4FA3",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#FFB3D9" }
    },
    {
      "scope": "number",
      "settings": { "foreground": "#E0B3FF" }
    },
    {
      "scope": "function",
      "settings": { "foreground": "#D98FFF" }
    },
    {
      "scope": "constant",
      "settings": { "foreground": "#FF9EE8" }
    },
    {
      "scope": "storage",
      "settings": {
        "foreground": "#FF2D95",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "type",
      "settings": { "foreground": "#FFB3D9" }
    },
    {
      "scope": "punctuation",
      "settings": { "foreground": "#D9A8C9" }
    },
    {
      "scope": "meta",
      "settings": { "foreground": "#EBC7DE" }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#D6407F"
      }
    }
  ]
}