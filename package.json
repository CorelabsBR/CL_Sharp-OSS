{
  "name": "NPSharp",
  "version": "26.8.39",
  "description": "NPSharp migrated to Electron, TypeScript and Monaco Editor.",
  "main": "dist-electron/main/main.js",
  "type": "commonjs",
  "author": "CoreLabs",
  "homepage": "https://github.com/CoreLabsBR/CL_NPSharp",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoreLabsBR/CL_NPSharp.git"
  },
  "license": "SEE LICENSE IN ../NPSharp/LICENSE.txt",
  "scripts": {
    "config:sync": "node scripts/sync-project-config.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run config:sync && node scripts/dev.mjs",
    "dev:renderer": "npm run config:sync && vite",
    "build:renderer": "npm run config:sync && vite build",
    "build:electron": "npm run config:sync && tsc -p tsconfig.electron.json",
    "build:server": "tsc -p npsharp-server/tsconfig.json",
    "dev:electron": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput --watchFile fixedPollingInterval --watchDirectory fixedPollingInterval",
    "typecheck": "npm run config:sync && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p npsharp-server/tsconfig.json",
    "lint": "npm run config:sync && eslint .",
    "test": "npm run test:easter-egg && npm run test:updater && npm run test:remote",
    "test:remote": "npm run build:electron && npm run build:server && node dist-electron/services/node/remote/remoteProtocol.test.js && node --test npsharp-server/dist/security/PathGuard.test.js",
    "test:easter-egg": "npm run build:electron && node scripts/gta6-easter-egg.test.mjs",
    "test:updater": "npm run build:electron && node dist-electron/services/node/updateSemver.test.js && node dist-electron/services/node/updateService.test.js && node dist-electron/services/node/updateIpc.test.js",
    "build": "node scripts/build.mjs",
    "build:mobile": "npm run config:sync && npm run typecheck && npm run build:renderer",
    "package": "node scripts/build.mjs",
    "package:linux": "node scripts/build.mjs linux",
    "package:win": "node scripts/build.mjs win",
    "package:portable-fast": "node scripts/build.mjs portable-fast",
    "mobile:init": "node scripts/mobile-init.mjs",
    "cap:sync": "npm run config:sync && npm run build:mobile && npx cap sync android",
    "android": "npm run cap:sync && npx cap run android",
    "android:open": "npm run cap:sync && npx cap open android",
    "mobile:sync": "npm run cap:sync",
    "mobile:android": "npm run android:open"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "discord-rpc": "^4.0.1",
    "electron-updater": "6.8.9",
    "extract-zip": "^2.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.56.0",
    "sql.js": "^1.14.1",
    "ssh2": "^1.17.0",
    "ws": "8.18.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^26.1.2",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "8.18.1",
    "7zip-bin": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "br.com.corelabs.npsharp",
    "productName": "NPSharp",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "npsharp-server",
        "to": "npsharp-server",
        "filter": [
          "dist/**/*",
          "package.json"
        ]
      },
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": true,
    "nativeRebuilder": "parallel",
    "asar": true,
    "compression": "normal",
    "asarUnpack": [
      "node_modules/node-pty/**/*",
      "node_modules/cpu-features/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "CoreLabs",
      "synopsis": "NPSharp IDE",
      "description": "NPSharp is a fast, modern and developer-first IDE powered by Electron, React and Monaco Editor."
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "mac": {
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NPSharp",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": "NPSharp"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "afterInstall": "build/linux-after-install.sh",
      "fpm": [
        "--deb-no-default-config-files"
      ],
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "libasound2",
        "libgbm1",
        "libdrm2",
        "libxkbcommon0",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "CoreLabsBR",
        "repo": "CL_NPSharp",
        "releaseType": "release"
      }
    ]
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
